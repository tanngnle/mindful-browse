{
  "manifest_version": 3,
  "name": "MindfulBrowse",
  "version": "1.0.0",
  "description": "Block distracting websites and replace them with a beautiful Pomodoro timer to help you stay focused.",
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MindfulBrowse — Stay Focused"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html", "blocked/blocked.css", "blocked/blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
